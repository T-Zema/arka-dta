!/Maps/Missions/arka01.png
!/Maps/Missions/arka02.map
!/Maps/Missions/arka02.png
!/Maps/Missions/FRSTBITE.MAP
!/MIX/
/MIX/*
!/MIX/ECACHE78.MIX
!/MIX/ECACHE79.MIX
!/MIX/ECACHE80.MIX
